{
  "name": "loba-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:learn": "npm run dev --prefix learn",
    "build:learn": "npm ci --prefix learn --no-audit --no-fund && npm run build --prefix learn",
    "seed:extract": "node scripts/extract-lessons.js",
    "admin:reset": "node --env-file-if-exists=.env scripts/reset-password.js",
    "test": "node --test tests/*.test.js",
    "test:learn": "npm test --prefix learn",
    "check": "node --check server/index.js && node --check server/app.js && node --check server/store.js && node --check admin/app.js && node --check learner.js"
  },
  "dependencies": {
    "pg": "8.16.3",
    "@tabler/core": "1.7.5",
    "lottie-web": "5.13.0"
  }
}
