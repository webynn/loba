DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loba
ADMIN_EMAIL=you@example.com
# Set a unique password with at least 14 characters. Never commit the real .env file.
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development

# Optional learner Google sign-in. Keep the secret in Railway variables, never Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://congolingo.com/api/learn/google/callback
